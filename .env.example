# Database Configuration - PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/internship_hub
# Example: postgresql://username:password@host:port/database_name

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development
DEBUG=true

# Auto Bootstrap Settings
AUTO_BOOTSTRAP=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
# BASE_URL=http://localhost:8000  # Optional: Override computed base URL

# Admin User (for seeding)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Test Users (for seeding)
TEST_USER1_USERNAME=user1
TEST_USER1_EMAIL=user1@example.com
TEST_USER1_PASSWORD=user123

TEST_USER2_USERNAME=user2
TEST_USER2_EMAIL=user2@example.com
TEST_USER2_PASSWORD=user456